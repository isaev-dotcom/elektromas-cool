# ---------------------------------------------------------------------------
# VORLAGE – noch NICHT aktiv.
#
# Um den Schulungsbereich mit Login zu schützen, diese Datei nach
#   schulung/.htaccess
# kopieren und den Pfad in AuthUserFile anpassen. Danach ist alles unterhalb
# von /schulung/ nur noch nach Anmeldung erreichbar – auch PDFs und Videos.
#
# Benutzername = E-Mail-Adresse des Teilnehmers.
# Passwörter stehen in der Datei .htpasswd (NICHT im Git-Repository!).
#
# WICHTIG: AuthUserFile braucht einen ABSOLUTEN Serverpfad. Den zeigt der
# Dateimanager im Alphahosting-Kundenmenü / Plesk. Beispiele:
#   /var/www/vhosts/elektromas.cool/httpdocs/schulung/.htpasswd
#   /home/www/p123456/html/schulung/.htpasswd
# ---------------------------------------------------------------------------

AuthType Basic
AuthName "Schulungsbereich elektromas GmbH – Benutzername ist Ihre E-Mail-Adresse"
AuthUserFile /ABSOLUTER/PFAD/ZUM/DOCUMENT-ROOT/schulung/.htpasswd
Require valid-user

# Keine Verzeichnislisten für inhalte/
Options -Indexes

# Passwortdatei und .htaccess selbst nie ausliefern
<FilesMatch "^\.ht">
  Require all denied
</FilesMatch>

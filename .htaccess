# Grundeinstellungen für elektromas.cool

Options -Indexes
DirectoryIndex index.php index.html

# Der Schulungsbereich liegt unter /Schulungen/ (großes S, Mehrzahl).
# Linux unterscheidet Groß- und Kleinschreibung in Adressen, deshalb leiten
# wir die naheliegenden Schreibweisen dorthin um.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{REQUEST_URI} !^/Schulungen(/|$)
  RewriteRule ^schulung(en)?/?$ /Schulungen/ [NC,R=301,L]

  # Dasselbe für das Projekt-Dashboard unter /Projekte/
  RewriteCond %{REQUEST_URI} !^/Projekte(/|$)
  RewriteRule ^(projekte?|dashboard)/?$ /Projekte/ [NC,R=301,L]

  # Und für das Business TRIZ Portal unter /TRIZ/. Ausgeschrieben wird die
  # Adresse als elektromas.cool/triz - der Verzeichnisname ist aber groß.
  RewriteCond %{REQUEST_URI} !^/TRIZ(/|$)
  RewriteRule ^triz/?$ /TRIZ/ [NC,R=301,L]
</IfModule>

# Konfigurations- und Passwortdateien nie ausliefern
<FilesMatch "^\.ht|\.(env|sql|log)$">
  Require all denied
</FilesMatch>

# Anmeldung und Verwaltung gehören nicht in Suchmaschinen
<IfModule mod_headers.c>
  <FilesMatch "\.php$">
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>

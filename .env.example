# Zugangsdaten für das Deployment
#
# ANLEITUNG
#   1. Diese Datei kopieren und die Kopie ".env" nennen:
#          cp .env.example .env
#   2. In der .env die Werte eintragen.
#   3. Die .env NIE weitergeben und nie committen - sie steht in .gitignore.
#
# Wo finde ich die Werte?
#   Alfahosting-Kundenmenü -> Vertrag -> Zugänge -> CloudPit -> FTP.
#   Dort stehen Server, Benutzername und das FTP-Passwort.

# ftps = FTP über TLS, Port 21 (empfohlen - gleicher Aufwand, verschlüsselt)
# ftp  = klassisches FTP, Port 21 (Passwort und Dateien im Klartext)
# sftp = über SSH, Port 22 (braucht einen SSH-Schlüssel, siehe unten)
PROTOCOL=ftps

# Server-Adresse, z. B. h283886.host298.alfahosting-server.de
DEPLOY_HOST=

# FTP-Benutzername
DEPLOY_USER=

# Wird automatisch gesetzt: 21 für ftps/ftp, 22 für sftp.
# Nur eintragen, wenn dein Hoster einen abweichenden Port nennt.
#DEPLOY_PORT=

# Zielverzeichnis auf dem Server (bestätigt: /httpdocs)
REMOTE_DIR=/httpdocs

# FTP-Passwort. Bleibt nur auf diesem Rechner.
DEPLOY_PASS=

# Nur für PROTOCOL=sftp: Pfad zum privaten SSH-Schlüssel.
# Für ftps/ftp leer lassen.
SSH_KEY=

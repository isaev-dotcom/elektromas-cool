# Zugangsdaten für das Deployment
#
# ANLEITUNG
#   1. Diese Datei kopieren und die Kopie ".env" nennen:
#          cp .env.example .env
#   2. In der .env die Werte eintragen.
#   3. Die .env NIE weitergeben und nie committen - sie steht in .gitignore.
#
# Wo finde ich die Werte?
#   Alfahosting-Kundenmenü -> Vertrag -> Zugänge -> CloudPit.
#   Für SSH/SFTP: Übersicht -> "Shell-Zugang einrichten". Dort stehen Server,
#   Port und Benutzername. Das Passwort ist dasselbe wie das primäre
#   FTP-Passwort. SFTP funktioniert nur mit dem PRIMÄREN FTP-Benutzer.

# "sftp" (empfohlen, Port 22) oder "ftp" (unverschlüsselt, Port 21)
PROTOCOL=sftp

# Server-Adresse, z. B. h283886.host298.alfahosting-server.de
DEPLOY_HOST=

# Benutzername des primären FTP-Benutzers
DEPLOY_USER=

# 22 für SFTP, 21 für FTP
DEPLOY_PORT=22

# Zielverzeichnis auf dem Server (bestätigt: /httpdocs)
REMOTE_DIR=/httpdocs

# ---------------------------------------------------------------------------
# Authentifizierung - EINE der beiden Varianten ausfüllen
# ---------------------------------------------------------------------------

# Variante A (empfohlen): SSH-Schlüssel.
#   Kein Passwort auf der Platte, funktioniert mit dem bereits installierten
#   OpenSSH. Pfad zum privaten Schlüssel:
SSH_KEY=

# Variante B: Passwort.
#   Nur nutzbar, wenn "lftp" installiert ist - der Windows-eigene sftp-Client
#   kann kein Passwort aus einer Datei lesen und fragt jedes Mal nach.
DEPLOY_PASS=
